use crate::binary_market::common::{
    and,
    ensure_burn_script,
    ensure_output_script,
    not,
    script_for_slot,
};

// A/B confidential one-unit RT commitments.

pub type CompressedCommitment = (bool, u256); // (odd y, x)
// (side-A asset, side-B asset, side-independent one-unit value)
pub type RtCommitments = (CompressedCommitment, CompressedCommitment, CompressedCommitment);

fn commitment_matches(actual: (u1, u256), expected: CompressedCommitment) -> bool {
    let (actual_parity, actual_x): (u1, u256) = actual;
    let (expected_parity, expected_x): CompressedCommitment = expected;
    and(
        jet::eq_1(actual_parity, <bool>::into(expected_parity)),
        jet::eq_256(actual_x, expected_x),
    )
}

fn get_input_confidential_commitments(index: u32) -> ((u1, u256), (u1, u256)) {
    let (asset, amount): (Asset1, Amount1) = unwrap(jet::input_amount(index));
    let asset_commitment: (u1, u256) = unwrap_left::<u256>(asset);
    let value_commitment: (u1, u256) = unwrap_left::<u64>(amount);
    (asset_commitment, value_commitment)
}

fn get_output_confidential_commitments(index: u32) -> ((u1, u256), (u1, u256)) {
    let (asset, amount): (Asset1, Amount1) = unwrap(jet::output_amount(index));
    let asset_commitment: (u1, u256) = unwrap_left::<u256>(asset);
    let value_commitment: (u1, u256) = unwrap_left::<u64>(amount);
    (asset_commitment, value_commitment)
}

pub fn yes_rt_commitments() -> RtCommitments {
    (
        (param::YES_RT_ASSET_A_PARITY, param::YES_RT_ASSET_A_X),
        (param::YES_RT_ASSET_B_PARITY, param::YES_RT_ASSET_B_X),
        (param::YES_RT_VALUE_PARITY, param::YES_RT_VALUE_X),
    )
}

pub fn no_rt_commitments() -> RtCommitments {
    (
        (param::NO_RT_ASSET_A_PARITY, param::NO_RT_ASSET_A_X),
        (param::NO_RT_ASSET_B_PARITY, param::NO_RT_ASSET_B_X),
        (param::NO_RT_VALUE_PARITY, param::NO_RT_VALUE_X),
    )
}

pub fn ensure_same_rt_input_side(
    yes_input_is_side_a: bool,
    no_input_is_side_a: bool,
) {
    assert!(jet::eq_1(
        <bool>::into(yes_input_is_side_a),
        <bool>::into(no_input_is_side_a),
    ));
}

// Validate the complete input/output commitments and return the input side.
// Every transition, including terminal burns, must flip A <-> B.
fn ensure_rt_flip(
    input_index: u32,
    output_index: u32,
    expected_commitments: RtCommitments,
) -> bool {
    let (asset_a_commitment, asset_b_commitment, value_commitment): RtCommitments =
        expected_commitments;
    let (input_asset_commitment, input_value_commitment): ((u1, u256), (u1, u256)) =
        get_input_confidential_commitments(input_index);
    let (output_asset_commitment, output_value_commitment): ((u1, u256), (u1, u256)) =
        get_output_confidential_commitments(output_index);

    assert!(commitment_matches(input_value_commitment, value_commitment));
    assert!(commitment_matches(output_value_commitment, value_commitment));

    let input_is_side_a: bool = commitment_matches(input_asset_commitment, asset_a_commitment);
    let input_is_side_b: bool = commitment_matches(input_asset_commitment, asset_b_commitment);
    match input_is_side_a {
        true => {
            assert!(not(input_is_side_b));
            assert!(commitment_matches(output_asset_commitment, asset_b_commitment));
        },
        false => {
            assert!(input_is_side_b);
            assert!(commitment_matches(output_asset_commitment, asset_a_commitment));
        },
    };
    input_is_side_a
}

pub fn ensure_rt_continuation(
    input_index: u32,
    output_index: u32,
    expected_commitments: RtCommitments,
    continuation_slot: u8,
) -> bool {
    let input_is_side_a: bool = ensure_rt_flip(input_index, output_index, expected_commitments);
    ensure_output_script(output_index, script_for_slot(continuation_slot));
    input_is_side_a
}

pub fn ensure_rt_burn(
    input_index: u32,
    output_index: u32,
    expected_commitments: RtCommitments,
) -> bool {
    let input_is_side_a: bool = ensure_rt_flip(input_index, output_index, expected_commitments);
    ensure_burn_script(output_index);
    input_is_side_a
}
